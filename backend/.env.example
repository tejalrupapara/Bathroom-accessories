# Server Runtime Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
# Replace <username>, <password>, and <cluster> with your details
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexxora?retryWrites=true&w=majority

# JWT Authentication secret
# Generate a secure random string (e.g. openssl rand -base64 32)
JWT_SECRET=NEXXORA_SECRET_KEY_123456

# SMTP Transactional Mail Configuration (Nodemailer)
# Default is configured for Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=greenvolt28@gmail.com
# For Gmail, you MUST use a 16-character App Password (not your account password)
SMTP_PASS=your_gmail_app_password_here

# Notification Receiver Address
NOTIFICATION_EMAIL=greenvolt28@gmail.com

# Twilio WhatsApp Configuration
# You must obtain a Twilio account to populate the SID and Auth Token
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_WHATSAPP=whatsapp:+14155238886
TO_WHATSAPP=whatsapp:+919998664704
